if SHIELD_NICE_VIEW_CUSTOM

config ZMK_DISPLAY
    default y

config LV_USE_LABEL
    default y

config LV_USE_CANVAS
    default y

config LV_USE_IMG
    default y

config LV_FONT_MONTSERRAT_16
    default y

config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 161

